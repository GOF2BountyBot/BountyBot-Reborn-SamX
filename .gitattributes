# Default: all text files use LF line endings.
# Linux/Docker project — CRLF would break shell scripts, Python tooling,
# and confuse multi-host development.
* text=auto eol=lf

# Source code
*.py        text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf

# Config
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
.env.*      text eol=lf

# Docs
*.md        text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf

# Build / container
Dockerfile*         text eol=lf
docker-compose*.yml text eol=lf
Makefile            text eol=lf
*.mk                text eol=lf

# Binary files — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    binary
*.webp   binary
*.blend  binary
*.7z     binary
*.zip    binary
*.tar    binary
*.gz     binary
*.zst    binary
*.aei    binary
*.obj    binary
*.mtl    binary
*.dds    binary
*.pdf    binary
