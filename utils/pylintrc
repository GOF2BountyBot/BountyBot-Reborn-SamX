[MASTER]
ignore-paths=.*lib/AEPi.*

[BASIC]
good-names=i,j,k,ex,_,id,db,e,f,v

[MESSAGES CONTROL]
# C0111: Missing docstring
# C0103: Variable name doesn't conform to naming style
# C0114: Missing module docstring
# C0115: Missing class docstring
# C0116: Missing function/method docstring
# C0301: Line too long — ruff enforces max-line-length=120; pylint duplicate check is noise;
#         long lines are intentional inline-comment anchors (e.g. # noqa: TRANSACTION_DISCIPLINE)
# C0302: Too many lines in module
# C0325: Superfluous parens — parens around chain comparisons (`not a <= b <= c`) and
#         inline keyword-argument expressions (`is_active=(i == 1)`) add clarity; ruff
#         already handles formatting uniformity
# C0411: Wrong import order (conflicts with project structure)
# C0412: Ungrouped imports (conflicts with ruff/isort's third-party vs first-party grouping)
# C0413: Wrong import position (required by Alembic env/revisions)
# C0415: Import outside toplevel (lazy imports are intentional)
# C1803: use-implicit-booleaness-not-comparison — `assert errors == []` is an explicit
#         value assertion in tests; preferred over `assert not errors` for failure messages
# C2801: unnecessary-dunder-call — `__aenter__` called directly in integration tests to
#         control session lifecycle; `__init__` called in reset() for re-initialisation
# C3001: unnecessary-lambda-assignment — conditional lambda dispatch (`get = lambda ...`)
#         and module-level serialiser callbacks are intentional; already have # noqa: E731
# E0110: abstract-class-instantiated — false positive: `type("Concrete", (ABC,), {...})()`
#         creates a fully-concrete class dynamically; pytest.raises(TypeError) wraps
#         intentional instantiation attempts to test ABC enforcement
# E0401: False positive on shared.bblogger (only available in Docker). The 'shared'
#        package (bblogger, http_retry) is copied in at image build, so it is missing at
#        lint time; see ignored-modules=shared in [TYPECHECK], which also covers E0611.
# E1101: False positive on alembic.op proxy object
# E1111: assignment-from-no-return — false positive: `__get__` on a function returns a
#         bound method (pylint can't infer it); explicit `result = f()` then
#         `assert result is None` is valid test idiom for functions returning None
# E1120: no-value-for-argument — false positive: api-test.py wrapper _create_thread()
#         has its own signature; discord-gateway/src/api-test.py is a standalone manual
#         test script, not a pytest module; base.py log calls are fixed separately
# E1121: too-many-function-args — same api-test.py standalone script; not pytest
# E1123: unexpected-keyword-arg — intentional inside pytest.raises(TypeError) to verify
#         that previously-removed constructor fields stay removed (D6 regression tests)
# E1135: unsupported-membership-test — false positive: Pydantic v2 `model_fields` is a
#         plain dict (confirmed via `type(Model.model_fields) == dict`); pylint cannot
#         infer it through the metaclass
# E1136: False positive on SQLAlchemy Mapped[] subscripts
# R0401: Circular import check (false positive with SQLAlchemy relationship graphs)
# R0801: Duplicate code (acceptable in similar repo/executor patterns)
# R0902: too-many-instance-attributes — game-domain dataclasses (WeaponStats, ModuleStats,
#         ShipLoadout, CombatResolver) inherently carry many fields; splitting would harm
#         cohesion; max-attributes=12 already relaxed from default 7
# R0903: Too few public methods
# R0904: too-many-public-methods — test classes legitimately exceed 20 methods; each
#         test method is a single focused assertion; splitting test classes is
#         counter-productive
# R0911: Too many return statements
# R0912: Too many branches
# R0913: Too many arguments
# R0914: Too many local variables
# R0915: Too many statements
# R0917: Too many positional arguments
# R1702: Too many nested blocks
# R1705: Unnecessary else after return
# R1710: inconsistent-return-statements — false positive on async generators / abstract
#         method bodies where a missing return is intentional
# R1711: useless-return — trailing `return` in test functions and async handlers is
#         explicit intent marker; not worth churning test code for
# R1716: chained-comparison — false positive: `a <= 0 and b > 0` flags two DIFFERENT
#         variables; they cannot be merged into a single chain; pylint applies the rule
#         incorrectly when operands differ
# R1720: no-else-raise — `elif` after `raise` in test code mirrors the production
#         control-flow structure for readability; no-else-raise is style, not correctness
# R1731: consider-using-max-builtin — `if x < y: x = y` form is retained in test code
#         where it mirrors the production-code pattern for direct comparison; fixed in
#         all src occurrences; 1 remaining test occurrence is accepted noise
# R0402: consider-using-from-import — `import utils.offload as offload_mod` and
#         `import utils.autocomplete_state as autocomplete_state` import the MODULE OBJECT
#         intentionally (for reload() and state mutation); `from utils import x` would
#         give the same binding but the explicit module-object form documents intent
# R1714: consider-using-in — `a != x and b != x` → `x not in (a, b)` fixed in src
#         (combat_log_service.py); 1 remaining test occurrence (`initial_cargo == X or
#         initial_cargo == Y` for a computed value) is accepted noise
# R1721: unnecessary-comprehension — fixed in player_repository.py; remaining cases are
#         style-preference noise
# R1732: consider-using-with — api-test.py is a standalone manual test script; not CI
# W0101: unreachable — `yield` after `raise` inside an `@asynccontextmanager` is required
#         by the asynccontextmanager protocol even when unreachable; without the yield,
#         the decorated function would not be a generator and asynccontextmanager would fail
# W0102: dangerous-default-value — `_b=_box` in test closures is the intentional closure-
#         capture-via-default-arg pattern; the dict is shared by design
# W0106: Expression assigned to nothing (ternary dispatch pattern)
# W0108: unnecessary-lambda — `side_effect=lambda: f()` in test mocks is a common idiom
#         for ensuring late-binding or for wrapping callables; accepted test noise
# W0124: confusing-with-statement — false positive on valid Python 3 multi-context-manager
#         syntax `with a as x, b as y:` containing comma-separated managers
# W0143: comparison-with-callable — false positive: `embed.color == discord.Color.red()`
#         compares against the RETURN VALUE of the method call (parens present); pylint
#         incorrectly flags the right-hand side because `discord.Color.red` is a method
# W0201: Attribute defined outside __init__
# W0212: Access to protected member (intentional cross-class access)
# W0404: reimported — in test modules, re-importing inside child-process functions
#         (multiprocessing workers, module-reload tests) is intentional: the child has
#         a fresh interpreter and needs its own imports; also covers side-effect imports
#         (model registration for SQLAlchemy ORM metadata)
# W0511: TODO/FIXME notes
# W0603: Using global statement
# W0611: unused-import — all W0611 occurrences are in test code with # noqa: F401;
#         they are side-effect imports (ORM model registration, module reload testing);
#         no W0611 exists in src
# W0612: unused-variable — test variables like `rocket = _secondary(...)` are constructed
#         for side effects or as explicit "not used" baseline; already carry # noqa: F841
# W0613: Unused argument (required by interface/signature)
# W0621: redefined-outer-name — the ENTIRE bulk (6949/6958) is pytest fixture parameter
#         shadowing: a test function parameter MUST share its fixture's name; pylint
#         cannot distinguish fixture parameters from accidental shadowing; all 9 src
#         occurrences verified benign (FastAPI `app`/`format` params, adminCog closure,
#         blender script ordering quirk)
# W0622: redefined-builtin — `id` and `credits` are natural domain field names in a
#         game DB model (player id, in-game credits); `credits()` is a REPL-only Python
#         built-in never used in application code; `format` in blender textures.py is
#         the FastAPI API parameter name; `__name__` assignment in test_main_coverage is
#         on a module object attribute, not the local built-in
# W0632: unbalanced-tuple-unpacking — false positive: the assert immediately above the
#         unpack (`assert len(captured_args) == 3`) guarantees the correct length;
#         pylint cannot propagate the assertion's type narrowing
# W0718: Catching too general exception (intentional broad handlers)
# W0719: broad-exception-raised — `raise Exception(...)` in test mock side_effects is
#         standard; production code never raises bare Exception
# W1114: arguments-out-of-order — false positive in symmetry test: `_heuristic(b, a)`
#         intentionally reverses argument order to test h(a,b)==h(b,a); pylint applies
#         a heuristic based on variable name order
# W1510: subprocess-run-check — in backup-executor tests, return-code checks are done
#         manually; explicit `check=False` would change documented semantics for tests
#         that examine returncode directly
# W1514: unspecified-encoding — open() calls without encoding= in blender _render.py
#         read Blender-generated argument files on the same platform; api-test.py is
#         a standalone manual script; platform default is acceptable here
# R1735: use-dict-literal — test fixtures use `dict(key=value, ...)` form intentionally
#         for multi-line readability with many fields; this is a project style choice
disable=C0111,C0103,C0114,C0115,C0116,C0301,C0302,C0325,C0411,C0412,C0413,C0415,
        C1803,C2801,C3001,
        E0110,E0401,E1101,E1111,E1120,E1121,E1123,E1135,E1136,
        R0401,R0402,R0801,R0902,R0903,R0904,R0911,R0912,R0913,R0914,R0915,R0917,
        R1702,R1705,R1710,R1711,R1714,R1716,R1720,R1721,R1731,R1732,R1735,
        W0101,W0102,W0106,W0108,W0124,W0143,W0201,W0212,W0404,W0511,W0603,W0611,W0612,
        W0613,W0621,W0622,W0632,W0718,W0719,W1114,W1510,W1514

[FORMAT]
max-line-length=120

[DESIGN]
max-args=8
max-attributes=12
max-locals=20

[SIMILARITIES]
min-similarity-lines=6

[IMPORTS]
known-third-party=fastapi,sqlalchemy,discord,httpx,pydantic,uvicorn,apscheduler,shared

[TYPECHECK]
# 'shared' (bblogger, http_retry) is copied into each image at Docker build time
# (see the service Dockerfiles) and is therefore absent at lint time. Ignoring it
# suppresses both import-error (E0401) and no-name-in-module (E0611) for it without
# masking those checks for genuinely-resolvable modules elsewhere.
ignored-modules=shared
