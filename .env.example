# ============================================================================
# Multi-instance / side-by-side stacks
# ----------------------------------------------------------------------------
# Defaults below preserve the original single-stack behaviour exactly. To run a
# second stack (e.g. dev alongside prod) on the same host, copy this file into
# a SEPARATE checkout of the repo and override these in that checkout's .env:
#
#   COMPOSE_PROJECT_NAME=bountybot-dev   # compose project namespace
#   STACK_PREFIX=bountydev               # prefix for container + network names
#                                        # (keep ≤12 chars — bridge name has a
#                                        #  15-char Linux interface limit, and
#                                        #  STACK_PREFIX + "-br" must fit)
#   BRIDGE_NAME=bountydev-br             # Linux bridge interface name (≤15 chars)
#   HOST_DB_PORT=15432                   # shift host-side published ports so
#   HOST_BOTCORE_PORT=18000              # both stacks can coexist
#   HOST_GATEWAY_PORT=17999
#   HOST_BLENDER_PORT=18001
#   BOTAPPID=<separate dev Discord app>
#   BOTTOKEN=<separate dev Discord token>
#
# Volumes are bind-mounted under ./mappings/ relative to each compose file, so
# they isolate naturally as long as each stack lives in its own directory.
#
# Internal service-to-service ports (PORT, GATEWAY_PORT, BLENDER_PORT below) do
# NOT need to change — they're the in-container bind ports and only the
# host-side mapping is shifted.
# ============================================================================

COMPOSE_PROJECT_NAME=bountybot-stack
STACK_PREFIX=bountybot
BRIDGE_NAME=bountybot-br
HOST_DB_PORT=5432
HOST_BOTCORE_PORT=8000
HOST_GATEWAY_PORT=7999
HOST_BLENDER_PORT=8001

BOTAPPID=12347869876
BOTTOKEN=asdioewtuqpwoiutq340589q304985q05

ENABLE_FILE_LOGGING=true
LOG_LEVEL=TRACE
LOG_FILE=/app/data/logs/app.log
# This is also the default and should typically be left as-is. 
# Only change if the "bot-core" service is running on a different host
BOT_API_BASE_URL=http://bot-core:8000/api/v1

LOGGINGFOLDERPATH=/app/data/logs

# Database Configuration
POSTGRES_USER=bounty
POSTGRES_PASSWORD=bounty
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bountydb

# Connection Pool Configuration
# Single-worker sizing (P0-T1 / Decision D10): one uvicorn worker = one pool (not 4×).
# Formula: pool_size + max_overflow >= (2 * AUTOCOMPLETE_WARM_CONCURRENCY) + live_headroom
#   = (2 * 16) + 10 = 42 minimum.  60 total provides comfortable headroom.
# Must stay under Postgres max_connections (verify via SHOW max_connections; 100 on reference deploy).
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=20
# Pool recycle time in seconds (1 hour default)
DB_POOL_RECYCLE=3600

# Executor Pool Sizing
# PROCESS_POOL_WORKERS — process pool for pure-Python CPU offload (combat resolver).
#   Should be <= (host cores - 1) to leave a core for the asyncio event loop.
#   Default 3 targets the prod host: a 4-core / 16 GB VPS.
#   Override DOWN on a sub-4-core VPS (e.g. PROCESS_POOL_WORKERS=1 on a 2-core).
# THREAD_POOL_WORKERS — thread pool for GIL-releasing IO (renders, pg_dump).
#   Defaults to max(4, 2 * PROCESS_POOL_WORKERS).
PROCESS_POOL_WORKERS=3
THREAD_POOL_WORKERS=6

# Database Settings
# Set to true to enable SQLAlchemy query logging (useful for debugging)
DB_ECHO=false

# Admin Permission Configuration
# Comma-separated list of Discord user IDs that are allowed to perform admin operations.
# Example: ADMIN_USER_IDS=123456789,987654321
# If left empty or unset, all users are allowed (development mode - not for production).
ADMIN_USER_IDS=

# Application Settings
# Allowed hosts for API listener - 0.0.0.0 == any origin IP
# NOTE:  Ports should probably not be changed unless there is an actual port conflict (unlikely)
HOST=0.0.0.0
PORT=8000
# Same for the Discord Gateway API listener...
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=7999
# Same for the Blender API listener...
BLENDER_HOST=0.0.0.0
BLENDER_PORT=8001
# Set RELOAD=false in production
RELOAD=true

# Verbose logging of FastAPI requests - ALL services...
ACCESS_LOG=false

# Health Check Configuration
# Timeout in seconds for health check operations
HEALTH_CHECK_TIMEOUT=5

# Timeout (seconds) for bot-core -> gateway calls that POST a Discord message
# (bounty announcement + "tier full" cap-payout notice). Raise this if slow
# Discord responses cause spawns to be rolled back despite the post succeeding.
BOUNTY_ANNOUNCE_TIMEOUT=30

# For blender service...
# If true, will do a warm-up render to precompile GPU bins (if a GPU is detected)
# Note: Setting to false will result in faster deploy times, but slower first render times.
# If no GPU is present (or allocated in compose file), this setting is largely irrelevant.
DO_WARMUP=true



# Assets Base Folder (Google Drive):  https://drive.google.com/drive/folders/1RYnlCVXbBc7FGPKvYaGvCHmobL_ZvCP8?usp=sharing
GAME_OBJS_FILEID=1oGwq6fm4OwGAYvwG94hEEVGt5e7a5Z1_

# Autocomplete cache tuning
AUTOCOMPLETE_WARM_ACTIVE_DAYS=7         # Players active within N days are warmed on startup. 0 = warm everyone.
AUTOCOMPLETE_WARM_CONCURRENCY=4         # Max concurrent inventory/ships fetches during warm + refresh.
AUTOCOMPLETE_WARM_GUILD_STAGGER_MS=200  # Spacing between per-guild warm jobs at startup (ms).
AUTOCOMPLETE_PLAYER_REFRESH_MINUTES=10  # Interval for player_cache bulk re-warm.
AUTOCOMPLETE_LOADOUT_REFRESH_MINUTES=5  # Interval for inventory/ships round-robin re-warm.
AUTOCOMPLETE_INVENTORY_MAX_ENTRIES=     # LRU cap on inventory_cache. Unset = no cap. Set for large deployments.
AUTOCOMPLETE_SHIPS_MAX_ENTRIES=         # LRU cap on ships_cache. Unset = no cap.
INTERNAL_AUTH_TOKEN=change-me-in-production  # Shared secret for bot-core → gateway internal push endpoints.

