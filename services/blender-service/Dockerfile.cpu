# CPU-only / slim build — no CUDA, no GPU rendering.
# Blender will use CPU rendering (CYCLES CPU fallback).
# Use this with docker-compose.yml (standard stack).
#
# To update Blender, change the version string below.
#   Browse available releases: https://download.blender.org/release/
#   Prefer LTS releases for stability: https://www.blender.org/download/lts/
# NOTE: If you bump to a new minor or major version (e.g. 4.5 → 5.0), also update
#   the URL folder name in the tarball install RUN step below (e.g. Blender4.5 → Blender5.0).
ARG BLENDER_VERSION=4.5.10

FROM python:3.13-slim-trixie AS base

ARG BLENDER_VERSION=4.5.10

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH=/opt/venv/bin:${PATH}
ENV PYTHONPATH=/opt/venv/

RUN echo 'tzdata tzdata/Areas select Etc' | debconf-set-selections && \
    echo 'tzdata tzdata/Zones/Etc select UTC' | debconf-set-selections && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        wget \
        git \
        openssl \
        # Required to decompress the Blender .tar.xz tarball
        xz-utils \
        # Required to build tex2img (AEPi dependency, no pre-built wheel)
        build-essential \
        # Blender runtime dependencies (X11, Wayland, OpenGL) — the official
        # tarball dynamically links against these and will fail at startup without them.
        libwayland-client0 \
        libwayland-egl1 \
        libx11-6 \
        libxxf86vm1 \
        libxcursor1 \
        libxi6 \
        libxrandr2 \
        libxinerama1 \
        libxkbcommon-dev \
        libxkbcommon-x11-dev \
        libsm6 \
        libice6 \
        # GL dispatch stubs
        libgl1 \
        libglx0 \
        libopengl0 \
        # Mesa software GL/EGL implementation — required on slim images that lack
        # the nvidia/cuda base libs. Provides the DRI backend that libGL dispatches to.
        libgl1-mesa-dri \
        libegl-mesa0 \
        libegl1 \
        libxt6 \
        # 7zip for extraction of assets on container startup
        7zip \
        # vim and sudo for debugging — comment out once stable
        # vim \
        # sudo \
    # CVE-2026-27135: libnghttp2-14 DoS via malformed HTTP/2 frames after session
    # termination. Fixed in 1.64.0-1.1+deb13u1 (trixie security).
    # CVE-2026-7598 / CVE-2026-55200 (+ SSH_MSG_EXT_INFO and SFTP-response DoS):
    # libssh2-1t64 integer overflow in userauth_password and out-of-bounds write in
    # the transport layer. Fixed in 1.11.1-1+deb13u1 (trixie security). libssh2 is
    # resident only as a transitive dep of git/libcurl. Upgrade both explicitly so
    # the fixes are pulled regardless of base-image snapshot date.
    # CVE-2026-34743: liblzma5 DoS via buffer overflow in index decoding.
    # Fixed in 5.8.1-1+deb13u1 (trixie security). liblzma5 backs xz-utils
    # (installed above for the Blender tarball) — upgrade explicitly so the
    # fix is pulled regardless of base-image snapshot date.
    # CVE-2025-59375, CVE-2026-24515/25210/32776/32777/32778/41080/45186/50219/
    # 56131/56132/56403–56412: 21 libexpat1 CVEs (4 HIGH — integer overflows in
    # storeAtts/addBinding/copyString/XML_ParseBuffer reachable as arbitrary code
    # execution, plus use-after-free and assorted parser DoS). Fixed in
    # 2.8.2-1~deb13u1 (trixie security); the base image ships 2.7.1-2. libexpat1
    # is a transitive dep (python3's pyexpat, dpkg, git) — upgrade explicitly so
    # the fix is pulled regardless of base-image snapshot date.
    && apt-get install -y --only-upgrade libnghttp2-14 libssh2-1t64 liblzma5 libexpat1 \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install Blender from the official tarball.
# We do NOT use apt (Ubuntu/Debian ship an older version lacking sm_120/Blackwell support)
# and NOT snap (requires systemd, unavailable in Docker).
#
# blender-cache/ (see .gitignore) lets an operator pre-place the matching
# tarball to build on a network where download.blender.org 403s (observed:
# Cloudflare bot-challenge blocking some IPs entirely, independent of which
# Blender version is requested) — the RUN step below uses it if present,
# otherwise falls back to the normal network download.
COPY services/blender-service/blender-cache/ /tmp/blender-cache/
RUN BLENDER_MAJOR_MINOR=$(echo "$BLENDER_VERSION" | cut -d. -f1,2) && \
    TARBALL="blender-${BLENDER_VERSION}-linux-x64.tar.xz" && \
    if [ -f "/tmp/blender-cache/${TARBALL}" ]; then \
        echo "Using locally-cached ${TARBALL}" && \
        cp "/tmp/blender-cache/${TARBALL}" "/tmp/${TARBALL}"; \
    else \
        wget -q "https://download.blender.org/release/Blender${BLENDER_MAJOR_MINOR}/${TARBALL}" -O "/tmp/${TARBALL}"; \
    fi && \
    rm -rf /tmp/blender-cache && \
    mkdir -p /opt/blender && \
    tar -xf "/tmp/${TARBALL}" --strip-components=1 -C /opt/blender && \
    ln -s /opt/blender/blender /usr/local/bin/blender && \
    rm -f "/tmp/${TARBALL}" && \
    test -x /opt/blender/blender

# Harden Blender's bundled Python against vendored CVEs.
#
# Blender ships its own embedded Python under /opt/blender/<MAJOR.MINOR>/python/ with
# pinned dependencies that quickly age out of CVE coverage. Strategy per package:
#
#   - setuptools (CVE-2022-40897 / CVE-2024-6345 / CVE-2025-47273)
#       Install-time tooling only; never invoked at Blender runtime. Drop dist-info.
#
#   - pip (CVE-2025-8869 + related; alerts #757/#758/#759)
#       Blender's runtime never invokes pip. CVE-2025-8869's actual mitigation comes
#       from Python 3.12+'s PEP 706 tarfile filters in the interpreter, not from pip
#       itself, so dropping pip is safe. Done LAST (after the install step) so it can
#       still be used to upgrade the runtime-relevant packages below.
#
#   - urllib3 (CVE-2025-66418 / CVE-2025-66471 / CVE-2026-21441)
#       Blender add-ons and online asset fetchers use it at runtime → genuine upgrade.
#
#   - requests (CVE-2024-47081 alert #760, CVE-2026-25645 alert #761)
#       Same runtime concern as urllib3 → genuine upgrade.
#
# Re-evaluate when Blender bumps its bundled Python (currently Python 3.11 in 4.5.x).
RUN BLENDER_PY_DIR="/opt/blender/$(echo "$BLENDER_VERSION" | cut -d. -f1,2)/python" && \
    BLENDER_PY="${BLENDER_PY_DIR}/bin/python3.11" && \
    SITE_PKGS="$(${BLENDER_PY} -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    echo "Blender site-packages: ${SITE_PKGS}" && \
    \
    # ── 1. setuptools (CVE-2022-40897 / CVE-2024-6345 / CVE-2025-47273) ────── \
    # Install-time tooling only; never invoked at Blender runtime. Drop dist-info. \
    rm -rf "${SITE_PKGS}"/setuptools-*.dist-info && \
    \
    # ── 2. urllib3 (CVE-2025-66418 / CVE-2025-66471 / CVE-2026-21441) ─────── \
    # Must DELETE the bundled 2.4.0 first, including its dist-info, because \
    # `pip install --target=<existing-dir>` does NOT replace existing packages \
    # cleanly: the old urllib3-2.4.0.dist-info/METADATA is left behind even \
    # after a successful "upgrade", and Trivy keeps reporting it. \
    rm -rf "${SITE_PKGS}"/urllib3 "${SITE_PKGS}"/urllib3-*.dist-info && \
    \
    # ── 3. requests (CVE-2024-47081 alert #760, CVE-2026-25645 alert #761) ── \
    # Same purge-then-reinstall pattern. Fix is in requests >=2.33.0. \
    rm -rf "${SITE_PKGS}"/requests "${SITE_PKGS}"/requests-*.dist-info && \
    \
    # ── 4. idna (CVE-2026-45409: bypass of CVE-2024-3651 fix) ─────────────── \
    # Blender 4.5 bundles idna 3.10; fixed in 3.15.0. Same purge-then-reinstall \
    # pattern: old dist-info must be removed before pip --target reinstalls cleanly. \
    rm -rf "${SITE_PKGS}"/idna "${SITE_PKGS}"/idna-*.dist-info && \
    true \
    # Note: pip itself is NOT deleted here — we need it alive for the next RUN. \
    # It's deleted at the end of the next RUN once the reinstalls are complete.

# We split the install step from the purge step above because we need pip to
# survive long enough to do the install, then we delete pip itself afterwards.
RUN BLENDER_PY_DIR="/opt/blender/$(echo "$BLENDER_VERSION" | cut -d. -f1,2)/python" && \
    BLENDER_PY="${BLENDER_PY_DIR}/bin/python3.11" && \
    SITE_PKGS="$(${BLENDER_PY} -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    \
    # Reinstall the runtime-relevant packages at safe versions \
    "${BLENDER_PY}" -m pip install --no-cache-dir --target="${SITE_PKGS}" \
        'urllib3>=2.6.3' \
        'requests>=2.33.0' \
        'idna>=3.15.0' && \
    \
    # ── Verification: every package must be at its fixed version ──────────── \
    URLLIB3_VER=$("${BLENDER_PY}" -c 'import urllib3; print(urllib3.__version__)') && \
    REQUESTS_VER=$("${BLENDER_PY}" -c 'import requests; print(requests.__version__)') && \
    IDNA_VER=$("${BLENDER_PY}" -c 'import idna; print(idna.__version__)') && \
    echo "Blender bundled urllib3: ${URLLIB3_VER}" && \
    echo "Blender bundled requests: ${REQUESTS_VER}" && \
    echo "Blender bundled idna: ${IDNA_VER}" && \
    case "${URLLIB3_VER}"  in 2.[6-9].*|2.[1-9][0-9].*|[3-9].*) ;; *) echo "urllib3 too old: ${URLLIB3_VER}";   exit 1 ;; esac && \
    case "${REQUESTS_VER}" in 2.33.*|2.3[4-9].*|2.[4-9][0-9].*|[3-9].*) ;; *) echo "requests too old: ${REQUESTS_VER}"; exit 1 ;; esac && \
    case "${IDNA_VER}" in 3.1[5-9]|3.1[5-9].*|3.[2-9][0-9]|3.[2-9][0-9].*|[4-9]*) ;; *) echo "idna too old: ${IDNA_VER}"; exit 1 ;; esac && \
    \
    # Hard-fail if any vulnerable dist-info survived from the previous Blender bundle \
    if ls "${SITE_PKGS}"/urllib3-2.4.*  >/dev/null 2>&1; then echo "ERROR: stale urllib3 2.4.x dist-info"; exit 1; fi && \
    if ls "${SITE_PKGS}"/requests-2.32.3* >/dev/null 2>&1; then echo "ERROR: stale requests 2.32.3 dist-info"; exit 1; fi && \
    if ls "${SITE_PKGS}"/idna-3.1[0-4].* >/dev/null 2>&1; then echo "ERROR: stale idna <3.15 dist-info"; exit 1; fi && \
    \
    # ── Final purge: drop pip itself now that installs are complete ──────── \
    # Done last so the install step above could still use it. \
    rm -rf "${SITE_PKGS}"/pip "${SITE_PKGS}"/pip-*.dist-info && \
    if ls "${SITE_PKGS}"/pip-*.dist-info >/dev/null 2>&1; then echo "ERROR: pip dist-info still present"; exit 1; fi

# Create a virtual environment
RUN python -m venv /opt/venv

# ── System-Python pip hardening (CVE-2025-8869 alert #756) ──────────────────
# The base image (python:3.13-slim-trixie) ships pip 26.0.1 in the SYSTEM
# Python at /usr/local/lib/python3.13/site-packages/. We use /opt/venv/bin/pip
# for all our actual installs, so the system pip is dead weight after the venv
# has been created above. CVE-2025-8869's runtime mitigation comes from
# Python 3.12+'s PEP 706 tarfile filters (already present in 3.13), not from
# pip itself; deleting the dist-info clears Trivy without losing protection.
#
# IMPORTANT: We invoke the system Python by its absolute path
# (/usr/local/bin/python3) rather than `python`, because `ENV PATH=/opt/venv/bin:...`
# at the top of this Dockerfile makes the bare `python` name resolve to the
# venv's interpreter. Asking the venv for its purelib would target /opt/venv,
# nuking the venv pip we depend on for the rest of the build.
RUN SYS_PY=/usr/local/bin/python3 && \
    SYS_SITE_PURELIB=$("${SYS_PY}" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])') && \
    DEB_SITE=/usr/lib/python3/dist-packages && \
    echo "System interpreter:    ${SYS_PY}" && \
    echo "System site-packages:  ${SYS_SITE_PURELIB}" && \
    echo "Debian dist-packages:  ${DEB_SITE} (if present)" && \
    # Sanity guard — refuse to nuke the venv if path detection ever points there \
    case "${SYS_SITE_PURELIB}" in /opt/venv/*) echo "ERROR: refusing to scrub venv site-packages"; exit 1 ;; esac && \
    rm -rf "${SYS_SITE_PURELIB}"/pip "${SYS_SITE_PURELIB}"/pip-*.dist-info && \
    rm -rf "${DEB_SITE}"/pip "${DEB_SITE}"/pip-*.dist-info && \
    # Hard-fail if any pip dist-info survived in either tree \
    if ls "${SYS_SITE_PURELIB}"/pip-*.dist-info >/dev/null 2>&1 || \
       ls "${DEB_SITE}"/pip-*.dist-info >/dev/null 2>&1; then \
        echo "ERROR: system pip dist-info still present"; exit 1; \
    fi && \
    # Verify venv pip is unaffected (different tree, must still import) \
    /opt/venv/bin/python -c 'import pip; print("venv pip OK:", pip.__version__)'

WORKDIR /app

# Upgrade pip toolchain in the venv (independent of the deleted system pip)
# CVE-2026-6357: pip < 26.1 arbitrary code execution via malicious wheel.
# Pin to >=26.1 explicitly so the fix is enforced regardless of base-image snapshot.
RUN /opt/venv/bin/pip install --upgrade --no-cache-dir \
    "pip>=26.1" \
    setuptools \
    wheel

# Copy and install requirements
COPY services/blender-service/requirements.txt .
COPY services/blender-service/src/lib/AEPi/requirements.txt ./aepi.requirements.txt

RUN /opt/venv/bin/pip install --upgrade --no-cache-dir --prefer-binary \
    -r requirements.txt \
    -r aepi.requirements.txt

# Install gdown for pulling assets from Google Drive
RUN /opt/venv/bin/pip install --upgrade --no-cache-dir --prefer-binary \
    gdown

# Catalog installed packages (useful for debugging)
RUN /opt/venv/bin/pip freeze

# Purge build-only packages now that all C extensions have been compiled.
# linux-libc-dev (kernel headers) is pulled in by build-essential and is not
# needed at runtime; removing it eliminates Trivy kernel CVE alerts that have
# no fixed version available in the Ubuntu 24.04 repos yet.
RUN apt-get remove -y --purge build-essential linux-libc-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Copy app code
COPY services/blender-service/ .

# Copy shared libs
COPY ./services/shared /app/src/shared

# Create a non-root user
RUN groupadd --gid 1002 botuser && \
    useradd --uid 1001 --gid botuser --shell /bin/bash --create-home botuser && \
    chown -R botuser /home/botuser && \
    chown -R botuser /app && \
    chmod -R 1777 /home/botuser && \
    chmod -R 1777 /app

USER botuser

ENTRYPOINT ["/bin/bash", "-c", "source /opt/venv/bin/activate && /app/docker-entrypoint.sh & tail -f /dev/null"]
