BOTAPPID=12347869876
BOTTOKEN=asdioewtuqpwoiutq340589q304985q05

ENABLE_FILE_LOGGING=true
LOG_LEVEL=TRACE
LOG_FILE=/app/data/logs/app.log
# This is also the default and should typically be left as-is. 
# Only change if the "bot-core" service is running on a different host
BOT_API_BASE_URL=http://bot-core:8000/api/v1

LOGGINGFOLDERPATH=/app/data/logs

# Database Configuration
POSTGRES_USER=bounty
POSTGRES_PASSWORD=bounty
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bountydb

# Connection Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
# Pool recycle time in seconds (1 hour default)
DB_POOL_RECYCLE=3600

# Database Settings
# Set to true to enable SQLAlchemy query logging (useful for debugging)
DB_ECHO=false

# Application Settings
# Allowed hosts for API listener - 0.0.0.0 == any origin IP
# NOTE:  Ports should probably not be changed unless there is an actual port conflict (unlikely)
HOST=0.0.0.0
PORT=8000
# Same for the Discord Gateway API listener...
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=7999
# Same for the Blender API listener...
BLENDER_HOST=0.0.0.0
BLENDER_PORT=8001
# Set RELOAD=false in production
RELOAD=true

# Verbose logging of FastAPI requests - ALL services...
ACCESS_LOG=false

# Health Check Configuration
# Timeout in seconds for health check operations
HEALTH_CHECK_TIMEOUT=5

# For blender service...
# If true, will do a warm-up render to precompile GPU bins (if a GPU is detected)
# Note: Setting to false will result in faster deploy times, but slower first render times.
# If no GPU is present (or allocated in compose file), this setting is largely irrelevant.
DO_WARMUP=true



