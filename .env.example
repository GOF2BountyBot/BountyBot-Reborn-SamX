BOTAPPID=12347869876
BOTTOKEN=asdioewtuqpwoiutq340589q304985q05

ENABLE_FILE_LOGGING=true
LOG_LEVEL=TRACE
LOG_FILE=/app/data/logs/app.log
# This is also the default and should typically be left as-is. 
# Only change if the "bot-core" service is running on a different host
BOT_API_BASE_URL=http://bot-core:8000/api/v1

LOGGINGFOLDERPATH=/app/data/logs

# Database Configuration
POSTGRES_USER=bounty
POSTGRES_PASSWORD=bounty
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bountydb

# Connection Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
# Pool recycle time in seconds (1 hour default)
DB_POOL_RECYCLE=3600

# Database Settings
# Set to true to enable SQLAlchemy query logging (useful for debugging)
DB_ECHO=false

# Admin Permission Configuration
# Comma-separated list of Discord user IDs that are allowed to perform admin operations.
# Example: ADMIN_USER_IDS=123456789,987654321
# If left empty or unset, all users are allowed (development mode - not for production).
ADMIN_USER_IDS=

# Application Settings
# Allowed hosts for API listener - 0.0.0.0 == any origin IP
# NOTE:  Ports should probably not be changed unless there is an actual port conflict (unlikely)
HOST=0.0.0.0
PORT=8000
# Same for the Discord Gateway API listener...
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=7999
# Same for the Blender API listener...
BLENDER_HOST=0.0.0.0
BLENDER_PORT=8001
# Set RELOAD=false in production
RELOAD=true

# Verbose logging of FastAPI requests - ALL services...
ACCESS_LOG=false

# Health Check Configuration
# Timeout in seconds for health check operations
HEALTH_CHECK_TIMEOUT=5

# For blender service...
# If true, will do a warm-up render to precompile GPU bins (if a GPU is detected)
# Note: Setting to false will result in faster deploy times, but slower first render times.
# If no GPU is present (or allocated in compose file), this setting is largely irrelevant.
DO_WARMUP=true



# Assets Base Folder (Google Drive):  https://drive.google.com/drive/folders/1RYnlCVXbBc7FGPKvYaGvCHmobL_ZvCP8?usp=sharing
GAME_OBJS_FILEID=1oGwq6fm4OwGAYvwG94hEEVGt5e7a5Z1_

# Autocomplete cache tuning
AUTOCOMPLETE_WARM_ACTIVE_DAYS=7         # Players active within N days are warmed on startup. 0 = warm everyone.
AUTOCOMPLETE_WARM_CONCURRENCY=4         # Max concurrent inventory/ships fetches during warm + refresh.
AUTOCOMPLETE_WARM_GUILD_STAGGER_MS=200  # Spacing between per-guild warm jobs at startup (ms).
AUTOCOMPLETE_PLAYER_REFRESH_MINUTES=10  # Interval for player_cache bulk re-warm.
AUTOCOMPLETE_LOADOUT_REFRESH_MINUTES=5  # Interval for inventory/ships round-robin re-warm.
AUTOCOMPLETE_INVENTORY_MAX_ENTRIES=     # LRU cap on inventory_cache. Unset = no cap. Set for large deployments.
AUTOCOMPLETE_SHIPS_MAX_ENTRIES=         # LRU cap on ships_cache. Unset = no cap.
INTERNAL_AUTH_TOKEN=change-me-in-production  # Shared secret for bot-core → gateway internal push endpoints.

