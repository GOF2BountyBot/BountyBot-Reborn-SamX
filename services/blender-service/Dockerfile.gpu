# GPU / CUDA build — full NVIDIA CUDA runtime for GPU-accelerated Blender rendering.
# Use this with docker-compose-gpu.yml (GPU stack).
#
# Base image is nvidia/cuda runtime (not devel) — includes CUDA runtime libs and cuDNN
# but not the compiler toolchain, keeping the image significantly smaller than devel.
#
# To update Blender, change the version string below.
#   Browse available releases: https://download.blender.org/release/
#   Prefer LTS releases for stability: https://www.blender.org/download/lts/
# NOTE: If you bump to a new minor or major version (e.g. 4.5 → 5.0), also update
#   the URL folder name in the tarball install RUN step below (e.g. Blender4.5 → Blender5.0).
ARG UBUNTU_RELEASE=24.04
ARG CUDA_VERSION=13.0.0
ARG BLENDER_VERSION=4.5.10

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-ubuntu${UBUNTU_RELEASE} AS base

ARG BLENDER_VERSION=4.5.10

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CUDA_HOME=/usr/local/cuda-13
ENV PATH=/opt/venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:${PATH}
ENV PYTHONPATH=/opt/venv/

# Update CUDA apt repo keys
RUN apt-key del 7fa2af80 2>/dev/null || true && \
    sed -i '/developer\.download\.nvidia\.com\/compute\/cuda\/repos/d' /etc/apt/sources.list.d/* 2>/dev/null || true && \
    sed -i '/developer\.download\.nvidia\.com\/compute\/machine-learning\/repos/d' /etc/apt/sources.list.d/* 2>/dev/null || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends wget && \
    wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    rm -f cuda-keyring_1.1-1_all.deb

# Install system dependencies and Python 3.13 via deadsnakes PPA
# (Ubuntu 24.04 ships Python 3.12; deadsnakes provides 3.13)
RUN echo 'tzdata tzdata/Areas select Etc' | debconf-set-selections && \
    echo 'tzdata tzdata/Zones/Etc select UTC' | debconf-set-selections && \
    apt-get update && \
    apt-get --with-new-pkgs upgrade -y && \
    apt-get install -y --no-install-recommends \
        software-properties-common \
        apt-utils && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        wget \
        git \
        openssl \
        # Required to decompress the Blender .tar.xz tarball
        xz-utils \
        # Required to build tex2img (AEPi dependency, no pre-built wheel)
        build-essential \
        python3.13 \
        python3.13-venv \
        python3.13-dev \
        python3-pip \
        # Blender runtime dependencies (X11, Wayland, OpenGL)
        libwayland-client0 \
        libwayland-egl1 \
        libx11-6 \
        libxxf86vm1 \
        libxcursor1 \
        libxi6 \
        libxrandr2 \
        libxinerama1 \
        libxkbcommon-dev \
        libxkbcommon-x11-dev \
        libsm6 \
        libice6 \
        libgl1 \
        libglx0 \
        libopengl0 \
        libxt6t64 \
        # 7zip for extraction of assets on container startup
        7zip \
        # gosu for privilege drop in entrypoint (root → botuser)
        gosu \
        # vim and sudo for debugging — comment out once stable
        # vim \
        # sudo \
    # CVE-2026-8376 (heap buffer overflow in Perl_study_chunk / regex compile) and
    # CVE-2026-42496 (Archive::Tar path traversal via crafted symlinks). perl through
    # 5.38.2-3.2ubuntu0.2 is affected; fixed in 5.38.2-3.2ubuntu0.3 (noble-security).
    # perl is kept resident in this image by git (liberror-perl). Upgrade it explicitly
    # so the fix lands deterministically regardless of base-image apt snapshot / layer
    # caching — same pattern as the libnghttp2-14 pin in the bot-core/gateway images.
    && apt-get install -y --only-upgrade perl perl-base perl-modules-5.38 \
    # Same deterministic-upgrade pattern for the noble packages Trivy flagged on
    # this image (alerts #1036–#1060, all medium, all with fixes in noble-security).
    # These land as transitive deps of the installs above (wget/git/curl/
    # software-properties-common) and of the CUDA base, so their versions would
    # otherwise float with whatever apt snapshot the cached layer was built from.
    #   wget            CVE-2026-58469/58470/58471/58472 → 1.21.4-1ubuntu4.3,
    #                   CVE-2026-15146                   → 1.21.4-1ubuntu4.4
    #   krb5 libs       CVE-2026-11850/40355/40356       → 1.20.1-6ubuntu2.7
    #   PAM libs        CVE-2026-54411                   → 1.5.3-5ubuntu5.6
    #   libsqlite3-0    CVE-2026-50812/50813             → 3.45.1-1ubuntu2.7
    #   tar             CVE-2026-5704                    → 1.35+dfsg-3ubuntu0.4
    #   python3-httplib2 CVE-2026-59939                  → 0.20.4-3ubuntu0.1
    && apt-get install -y --only-upgrade \
        wget \
        libgssapi-krb5-2 libk5crypto3 libkrb5-3 libkrb5support0 \
        libpam-modules libpam-modules-bin libpam-runtime libpam0g \
        libsqlite3-0 \
        tar \
        python3-httplib2 \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN ln -sf /usr/bin/python3.13 /usr/bin/python3 && \
    ln -sf /usr/bin/python3 /usr/bin/python

# Install Blender from the official tarball.
# We do NOT use apt (Ubuntu 24.04 ships only 4.0.2 which lacks sm_120/Blackwell support)
# and NOT snap (requires systemd, unavailable in Docker).
#
# blender-cache/ (see .gitignore) lets an operator pre-place the matching
# tarball to build on a network where download.blender.org 403s (observed:
# Cloudflare bot-challenge blocking some IPs entirely, independent of which
# Blender version is requested) — the RUN step below uses it if present,
# otherwise falls back to the normal network download.
COPY services/blender-service/blender-cache/ /tmp/blender-cache/
RUN BLENDER_MAJOR_MINOR=$(echo "$BLENDER_VERSION" | cut -d. -f1,2) && \
    TARBALL="blender-${BLENDER_VERSION}-linux-x64.tar.xz" && \
    if [ -f "/tmp/blender-cache/${TARBALL}" ]; then \
        echo "Using locally-cached ${TARBALL}" && \
        cp "/tmp/blender-cache/${TARBALL}" "/tmp/${TARBALL}"; \
    else \
        wget -q "https://download.blender.org/release/Blender${BLENDER_MAJOR_MINOR}/${TARBALL}" -O "/tmp/${TARBALL}"; \
    fi && \
    rm -rf /tmp/blender-cache && \
    mkdir -p /opt/blender && \
    tar -xf "/tmp/${TARBALL}" --strip-components=1 -C /opt/blender && \
    ln -s /opt/blender/blender /usr/local/bin/blender && \
    rm -f "/tmp/${TARBALL}" && \
    test -x /opt/blender/blender

# Harden Blender's bundled Python against vendored CVEs.
# See Dockerfile.cpu for the full rationale (same patch applied to both variants).
RUN BLENDER_PY_DIR="/opt/blender/$(echo "$BLENDER_VERSION" | cut -d. -f1,2)/python" && \
    BLENDER_PY="${BLENDER_PY_DIR}/bin/python3.11" && \
    SITE_PKGS="$(${BLENDER_PY} -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    echo "Blender site-packages: ${SITE_PKGS}" && \
    \
    # ── 1. setuptools (CVE-2022-40897 / CVE-2024-6345 / CVE-2025-47273) ────── \
    rm -rf "${SITE_PKGS}"/setuptools-*.dist-info && \
    \
    # ── 2. urllib3 (CVE-2025-66418 / CVE-2025-66471 / CVE-2026-21441) ─────── \
    # Delete bundled 2.4.0 first; pip --target won't replace it cleanly. \
    rm -rf "${SITE_PKGS}"/urllib3 "${SITE_PKGS}"/urllib3-*.dist-info && \
    \
    # ── 3. requests (CVE-2024-47081 alert #760, CVE-2026-25645 alert #761) ── \
    rm -rf "${SITE_PKGS}"/requests "${SITE_PKGS}"/requests-*.dist-info && \
    \
    # ── 4. idna (CVE-2026-45409: bypass of CVE-2024-3651 fix) ─────────────── \
    # Blender 4.5 bundles idna 3.10; fixed in 3.15.0. Same purge-then-reinstall \
    # pattern: old dist-info must be removed before pip --target reinstalls cleanly. \
    rm -rf "${SITE_PKGS}"/idna "${SITE_PKGS}"/idna-*.dist-info && \
    true \
    # Note: pip itself is NOT deleted here — needed alive for the install RUN below. \
    # It's deleted at the end of that RUN once the reinstalls are complete.

# Reinstall + verify + final pip purge.
RUN BLENDER_PY_DIR="/opt/blender/$(echo "$BLENDER_VERSION" | cut -d. -f1,2)/python" && \
    BLENDER_PY="${BLENDER_PY_DIR}/bin/python3.11" && \
    SITE_PKGS="$(${BLENDER_PY} -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    \
    "${BLENDER_PY}" -m pip install --no-cache-dir --target="${SITE_PKGS}" \
        'urllib3>=2.6.3' \
        'requests>=2.33.0' \
        'idna>=3.15.0' && \
    \
    URLLIB3_VER=$("${BLENDER_PY}" -c 'import urllib3; print(urllib3.__version__)') && \
    REQUESTS_VER=$("${BLENDER_PY}" -c 'import requests; print(requests.__version__)') && \
    IDNA_VER=$("${BLENDER_PY}" -c 'import idna; print(idna.__version__)') && \
    echo "Blender bundled urllib3: ${URLLIB3_VER}" && \
    echo "Blender bundled requests: ${REQUESTS_VER}" && \
    echo "Blender bundled idna: ${IDNA_VER}" && \
    case "${URLLIB3_VER}"  in 2.[6-9].*|2.[1-9][0-9].*|[3-9].*) ;; *) echo "urllib3 too old: ${URLLIB3_VER}";   exit 1 ;; esac && \
    case "${REQUESTS_VER}" in 2.33.*|2.3[4-9].*|2.[4-9][0-9].*|[3-9].*) ;; *) echo "requests too old: ${REQUESTS_VER}"; exit 1 ;; esac && \
    case "${IDNA_VER}" in 3.1[5-9]|3.1[5-9].*|3.[2-9][0-9]|3.[2-9][0-9].*|[4-9]*) ;; *) echo "idna too old: ${IDNA_VER}"; exit 1 ;; esac && \
    \
    if ls "${SITE_PKGS}"/urllib3-2.4.*  >/dev/null 2>&1; then echo "ERROR: stale urllib3 2.4.x dist-info"; exit 1; fi && \
    if ls "${SITE_PKGS}"/requests-2.32.3* >/dev/null 2>&1; then echo "ERROR: stale requests 2.32.3 dist-info"; exit 1; fi && \
    if ls "${SITE_PKGS}"/idna-3.1[0-4].* >/dev/null 2>&1; then echo "ERROR: stale idna <3.15 dist-info"; exit 1; fi && \
    \
    # ── Final purge: drop pip itself now that installs are complete (alerts #757/#758/#759) ── \
    # Blender's runtime never invokes pip; CVE-2025-8869's actual mitigation comes from PEP 706 in the interpreter. \
    rm -rf "${SITE_PKGS}"/pip "${SITE_PKGS}"/pip-*.dist-info && \
    if ls "${SITE_PKGS}"/pip-*.dist-info >/dev/null 2>&1; then echo "ERROR: pip dist-info still present"; exit 1; fi

# Create a virtual environment using Python 3.13
RUN python3.13 -m venv /opt/venv

# ── System-Python pip hardening (CVE-2025-8869 alert #756) ──────────────────
# Ubuntu 24.04 + python3-pip ships pip as a Debian-style dist-packages tree
# under /usr/lib/python3/dist-packages/. We use /opt/venv/bin/pip for actual
# installs, so the system pip is dead weight after the venv exists. PEP 706's
# tarfile filters in Python 3.13 provide the actual CVE-2025-8869 mitigation.
#
# IMPORTANT: We invoke the system Python by its absolute path (/usr/bin/python3.13)
# rather than `python3.13`, because `ENV PATH=/opt/venv/bin:...` at the top of
# this Dockerfile means the bare `python3.13` could resolve to /opt/venv (the
# venv interpreter is hard-linked there as `python3.13`). Asking the venv for
# its purelib would target /opt/venv, nuking the venv pip we depend on.
RUN SYS_PY=/usr/bin/python3.13 && \
    SYS_SITE_PURELIB=$("${SYS_PY}" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])') && \
    DEB_SITE=/usr/lib/python3/dist-packages && \
    echo "System interpreter:    ${SYS_PY}" && \
    echo "System site-packages:  ${SYS_SITE_PURELIB}" && \
    echo "Debian dist-packages:  ${DEB_SITE}" && \
    # Sanity guard — refuse to nuke the venv if path detection ever points there \
    case "${SYS_SITE_PURELIB}" in /opt/venv/*) echo "ERROR: refusing to scrub venv site-packages"; exit 1 ;; esac && \
    rm -rf "${SYS_SITE_PURELIB}"/pip "${SYS_SITE_PURELIB}"/pip-*.dist-info && \
    rm -rf "${DEB_SITE}"/pip "${DEB_SITE}"/pip-*.dist-info && \
    # Hard-fail if any pip dist-info survived in either tree \
    if ls "${SYS_SITE_PURELIB}"/pip-*.dist-info >/dev/null 2>&1 || \
       ls "${DEB_SITE}"/pip-*.dist-info >/dev/null 2>&1; then \
        echo "ERROR: system pip dist-info still present"; exit 1; \
    fi && \
    # Verify venv pip is unaffected (different tree, must still import) \
    /opt/venv/bin/python -c 'import pip; print("venv pip OK:", pip.__version__)'

WORKDIR /app

# Upgrade pip toolchain
# CVE-2026-6357: pip < 26.1 arbitrary code execution via malicious wheel.
# Pin to >=26.1 explicitly so the fix is enforced regardless of base-image snapshot.
RUN /opt/venv/bin/pip install --upgrade --no-cache-dir \
    "pip>=26.1" \
    setuptools \
    wheel

# Copy and install requirements
COPY services/blender-service/requirements.txt .
COPY services/blender-service/src/lib/AEPi/requirements.txt ./aepi.requirements.txt

RUN /opt/venv/bin/pip install --upgrade --no-cache-dir --prefer-binary \
    -r requirements.txt \
    -r aepi.requirements.txt

# Install gdown for pulling assets from Google Drive
RUN /opt/venv/bin/pip install --upgrade --no-cache-dir --prefer-binary \
    gdown

# Catalog installed packages (useful for debugging)
RUN /opt/venv/bin/pip freeze

# ── venv pip purge (alerts #1124–#1126) ─────────────────────────────────────
# pip 26.2 ships pip/_vendor/bom.cdx.json — a CycloneDX SBOM of its vendored
# dependencies — which Trivy reads and reports against: msgpack 1.1.2
# (GHSA-6v7p-g79w-8964, HIGH) and setuptools 70.3.0 (CVE-2025-47273 HIGH,
# CVE-2026-59890). Neither is fixable by upgrading pip — the vendored copies
# only move when pip re-vendors them. Every install is complete by this point
# and nothing at runtime invokes pip, so drop it; same reasoning as the
# system-pip purge above.
RUN rm -rf /opt/venv/lib/python*/site-packages/pip \
           /opt/venv/lib/python*/site-packages/pip-*.dist-info \
           /opt/venv/bin/pip /opt/venv/bin/pip3 /opt/venv/bin/pip3.* && \
    if ls /opt/venv/lib/python*/site-packages/pip-*.dist-info >/dev/null 2>&1; then \
        echo "ERROR: venv pip dist-info still present"; exit 1; \
    fi && \
    /opt/venv/bin/python -c 'import sys; print("venv python OK:", sys.version.split()[0])'

# Purge build-only packages now that all C extensions have been compiled.
# linux-libc-dev (kernel headers) is pulled in by build-essential and is not
# needed at runtime; removing it eliminates Trivy kernel CVE alerts that have
# no fixed version available in the Ubuntu 24.04 repos yet.
RUN apt-get remove -y --purge build-essential linux-libc-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Copy app code
COPY services/blender-service/ .

# Copy shared libs
COPY ./services/shared /app/src/shared

# Create a non-root user
RUN groupadd --gid 1002 botuser && \
    useradd --uid 1001 --gid botuser --shell /bin/bash --create-home botuser && \
    chown -R botuser /home/botuser && \
    chown -R botuser /app && \
    chmod -R 1777 /home/botuser && \
    chmod -R 1777 /app

# Sanity-check gosu is functional before the image is sealed.
RUN gosu nobody true

# The entrypoint starts as root, normalizes /app/data ownership, then drops to
# botuser via gosu (handled inside docker-entrypoint.sh root-check block).
# The '& tail -f /dev/null' keep-alive preserves original crash-survival behavior.
ENTRYPOINT ["/bin/bash", "-c", "source /opt/venv/bin/activate && /app/docker-entrypoint.sh & tail -f /dev/null"]
