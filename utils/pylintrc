[MASTER]
ignore-paths=.*lib/AEPi.*

[BASIC]
good-names=i,j,k,ex,_,id,db,e,f,v

[MESSAGES CONTROL]
# C0111: Missing docstring
# C0103: Variable name doesn't conform to naming style
# C0114: Missing module docstring
# C0115: Missing class docstring
# C0116: Missing function/method docstring
# C0302: Too many lines in module
# C0411: Wrong import order (conflicts with project structure)
# C0413: Wrong import position (required by Alembic env/revisions)
# C0415: Import outside toplevel (lazy imports are intentional)
# E0401: False positive on shared.bblogger (only available in Docker)
# E1101: False positive on alembic.op proxy object
# E1136: False positive on SQLAlchemy Mapped[] subscripts
# R0801: Duplicate code (acceptable in similar repo/executor patterns)
# R0903: Too few public methods
# R0911: Too many return statements
# R0912: Too many branches
# R0913: Too many arguments
# R0914: Too many local variables
# R0915: Too many statements
# R0917: Too many positional arguments
# R1702: Too many nested blocks
# R1705: Unnecessary else after return
# W0106: Expression assigned to nothing (ternary dispatch pattern)
# W0201: Attribute defined outside __init__
# W0212: Access to protected member (intentional cross-class access)
# W0511: TODO/FIXME notes
# W0603: Using global statement
# W0613: Unused argument (required by interface/signature)
# W0718: Catching too general exception (intentional broad handlers)
disable=C0111,C0103,C0114,C0115,C0116,C0302,C0411,C0413,C0415,
        E0401,E1101,E1136,
        R0801,R0903,R0911,R0912,R0913,R0914,R0915,R0917,R1702,R1705,
        W0106,W0201,W0212,W0511,W0603,W0613,W0718

[FORMAT]
max-line-length=120

[DESIGN]
max-args=8
max-attributes=12
max-locals=20

[SIMILARITIES]
min-similarity-lines=6

[IMPORTS]
known-third-party=fastapi,sqlalchemy,discord,httpx,pydantic,uvicorn,apscheduler,shared
